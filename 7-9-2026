#include <stdio.h>

int main() {
    int vector[5];
    int i;

    printf("Ingrese 5 valores:\n");

    for(i = 0; i < 5; i++) {
        scanf("%d", &vector[i]);
    }

    printf("\nIngrese los nuevos valores:\n");

    for(i = 0; i < 5; i++) {
        printf("Nuevo valor para la posicion %d: ", i);
        scanf("%d", &vector[i]);
    }

    printf("\nDatos del vector:\n");

    for(i = 0; i < 5; i++) {
        printf("Posicion %d: %d\n", i, vector[i]);
    }

    return 0;
}
